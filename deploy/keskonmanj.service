# Service systemd pour la Raspberry (framboise3).
# Installation : voir README.md, section « Déploiement sur la Raspberry ».
[Unit]
Description=Keskonmanj (suggestions de plats)
After=network-online.target
Wants=network-online.target

[Service]
User=chili
WorkingDirectory=/home/chili/keskonmanj
ExecStart=/home/chili/keskonmanj/server/.venv/bin/python server/main.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
